<UserControl x:Class="SpacePilot.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:enums="clr-namespace:SpacePilot.Core.Enums;assembly=SpacePilot.Core"
             xmlns:vm="clr-namespace:SpacePilot.App.ViewModels"
             mc:Ignorable="d" d:DesignHeight="750" d:DesignWidth="1000">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Settings &amp; Connection Profiles" Style="{StaticResource HeaderTitleText}" />
            <TextBlock Text="Manage DigitalOcean Spaces and S3 credentials (protected with Windows DPAPI), size thresholds, and concurrency"
                       Style="{StaticResource SubheaderText}" Margin="0,4,0,0" />
        </StackPanel>

        <!-- Main Layout -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Profiles List -->
            <Border Grid.Column="0" Style="{StaticResource ModernCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Storage Profiles" Style="{StaticResource SectionTitleText}" Margin="0,0,0,12" />

                    <ListBox Grid.Row="1" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}"
                             Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ModernCard}" Margin="0,0,0,6" Padding="10">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding BucketName, StringFormat=Bucket: {0}}" Style="{StaticResource SubheaderText}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Button Grid.Row="2" Content="+ Add Profile" Style="{StaticResource SecondaryButton}" Margin="0,10,0,0"
                            Command="{Binding AddProfileCommand}" />
                </Grid>
            </Border>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="12" Background="Transparent" />

            <!-- Profile & Global Settings Editor -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Connection Details Card -->
                    <Border Style="{StaticResource ModernCard}" Margin="0,0,0,16">
                        <StackPanel>
                            <Grid Margin="0,0,0,16">
                                <TextBlock Text="S3 Profile Credentials (Protected with Windows DPAPI)" Style="{StaticResource SectionTitleText}" />
                                <Button Content="Delete Profile" Style="{StaticResource DangerButton}" HorizontalAlignment="Right"
                                        Command="{Binding DeleteProfileCommand}" />
                            </Grid>

                            <!-- Profile Name -->
                            <TextBlock Text="Profile Name" Style="{StaticResource SubheaderText}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding SelectedProfile.Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

                            <!-- DigitalOcean Region Presets -->
                            <TextBlock Text="DigitalOcean Region Presets" Style="{StaticResource SubheaderText}" Margin="0,0,0,6" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Button Content="BLR1 (Bangalore)" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                                        Command="{Binding SetDigitalOceanPresetCommand}" CommandParameter="blr1" />
                                <Button Content="NYC3 (New York)" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                                        Command="{Binding SetDigitalOceanPresetCommand}" CommandParameter="nyc3" />
                                <Button Content="SGP1 (Singapore)" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                                        Command="{Binding SetDigitalOceanPresetCommand}" CommandParameter="sgp1" />
                                <Button Content="AMS3 (Amsterdam)" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                                        Command="{Binding SetDigitalOceanPresetCommand}" CommandParameter="ams3" />
                                <Button Content="FRA1 (Frankfurt)" Style="{StaticResource SecondaryButton}"
                                        Command="{Binding SetDigitalOceanPresetCommand}" CommandParameter="fra1" />
                            </StackPanel>

                            <!-- Endpoint & Region -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="160" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Service Endpoint URL" Style="{StaticResource SubheaderText}" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding SelectedProfile.ServiceEndpoint, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Region" Style="{StaticResource SubheaderText}" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding SelectedProfile.Region, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>

                            <!-- Bucket Name -->
                            <TextBlock Text="Bucket Name (Default: docs456)" Style="{StaticResource SubheaderText}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding SelectedProfile.BucketName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

                            <!-- Keys -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Access Key ID" Style="{StaticResource SubheaderText}" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding SelectedProfile.AccessKeyId, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Secret Access Key" Style="{StaticResource SubheaderText}" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding SelectedProfile.SecretAccessKey, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>

                            <!-- Test & Save Buttons -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0" Content="Test S3 Connection" Style="{StaticResource SecondaryButton}"
                                        Command="{Binding TestConnectionCommand}" />
                                <Button Grid.Column="2" Content="Save Profile" Style="{StaticResource PrimaryButton}"
                                        Command="{Binding SaveProfileCommand}" />
                                <TextBlock Grid.Column="3" Text="{Binding TestResult}" VerticalAlignment="Center" Margin="16,0,0,0"
                                           FontWeight="SemiBold" TextWrapping="Wrap" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Global Optimization Thresholds -->
                    <Border Style="{StaticResource ModernCard}">
                        <StackPanel>
                            <TextBlock Text="Global Compression &amp; Performance Rules" Style="{StaticResource SectionTitleText}" Margin="0,0,0,16" />

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Min Image Size (KB)" Style="{StaticResource SubheaderText}" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding Settings.MinimumImageSizeKb, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Min PDF Size (KB)" Style="{StaticResource SubheaderText}" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding Settings.MinimumPdfSizeKb, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Min Savings Required (%)" Style="{StaticResource SubheaderText}" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding Settings.MinimumSavingsPercentage, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>

                            <!-- Concurrency Workers Slider -->
                            <Grid Margin="0,8,0,6">
                                <TextBlock Text="Parallel Workers Concurrency" Style="{StaticResource SubheaderText}" />
                                <TextBlock Text="{Binding Settings.ParallelWorkers, StringFormat={}{0} concurrent workers}"
                                           HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="{StaticResource AccentLightBrush}" />
                            </Grid>
                            <Slider Minimum="1" Maximum="16" Value="{Binding Settings.ParallelWorkers}"
                                    TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,0,0,16" />

                            <!-- Safe rules explanation -->
                            <Border Background="{StaticResource SurfaceBgBrush}" CornerRadius="6" Padding="12">
                                <TextBlock Text="• Files smaller than threshold are skipped before decoding.&#x0a;• Minimum savings threshold prevents replacing files with marginal or negative gains.&#x0a;• Windows DPAPI encrypts sensitive keys; credentials are never written in plain text."
                                           Style="{StaticResource SubheaderText}" LineHeight="20" />
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
