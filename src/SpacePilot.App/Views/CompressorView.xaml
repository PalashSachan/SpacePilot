<UserControl x:Class="SpacePilot.App.Views.CompressorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:enums="clr-namespace:SpacePilot.Core.Enums;assembly=SpacePilot.Core"
             xmlns:vm="clr-namespace:SpacePilot.App.ViewModels"
             mc:Ignorable="d" d:DesignHeight="750" d:DesignWidth="1100">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header & Action Buttons -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Bulk Media Compression Studio" Style="{StaticResource HeaderTitleText}" />
                <TextBlock Text="Lossless and visually optimized image resizing, format conversion, and safe PDF compression"
                           Style="{StaticResource SubheaderText}" Margin="0,4,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Add Files..." Style="{StaticResource SecondaryButton}" Margin="0,0,10,0"
                        Click="OnAddFilesClick" />
                <Button Content="Test Selected" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0"
                        Command="{Binding TestSingleFileCommand}" />
                <Button Content="Dry Run" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0"
                        Command="{Binding StartBulkCompressionCommand}" CommandParameter="True" />
                <Button Content="Start Bulk Compression" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0"
                        Command="{Binding StartBulkCompressionCommand}" CommandParameter="False" />
                <Button Content="Clear" Style="{StaticResource SubtleButton}"
                        Command="{Binding ClearQueueCommand}" />
            </StackPanel>
        </Grid>

        <!-- 3-Column Studio Layout -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" />
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Column 1: Queue & Drag-Drop Zone -->
            <Grid Grid.Column="0" Margin="0,0,12,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="90" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Drag & Drop Zone -->
                <Border Grid.Row="0" Style="{StaticResource ModernCard}" Margin="0,0,0,12"
                        AllowDrop="True" Drop="OnDropFiles" DragOver="OnDragOverFiles"
                        BorderBrush="{StaticResource AccentBrush}" BorderThickness="1.5">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="Drag &amp; Drop Images or PDFs Here" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="JPG, PNG, WebP, BMP, TIFF, PDF" Style="{StaticResource SubheaderText}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <!-- Queue DataGrid -->
                <Border Grid.Row="1" Style="{StaticResource ModernCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock Text="File Queue" Style="{StaticResource SectionTitleText}" />
                            <TextBlock Text="{Binding Queue.Count, StringFormat={}{0} items}" HorizontalAlignment="Right" Style="{StaticResource SubheaderText}" />
                        </Grid>

                        <DataGrid Grid.Row="1" ItemsSource="{Binding Queue}" SelectedItem="{Binding SelectedItem}"
                                  AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                  HeadersVisibility="Column" SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name" Binding="{Binding FileName}" Width="*" />
                                <DataGridTextColumn Header="Size" Binding="{Binding OriginalSizeBytes, Converter={StaticResource ByteSizeConverter}}" Width="75" />
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90" />
                                <DataGridTextColumn Header="Saved" Binding="{Binding SavingsPercentage, Converter={StaticResource SavingsPercentageConverter}}" Width="65" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>

            <!-- Column 2: Compression & Resize Profiles -->
            <Border Grid.Column="1" Style="{StaticResource ModernCard}" Margin="0,0,12,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Optimization Settings" Style="{StaticResource SectionTitleText}" Margin="0,0,0,16" />

                        <!-- Mode Selection -->
                        <TextBlock Text="Compression Mode" Style="{StaticResource SubheaderText}" Margin="0,0,0,6" />
                        <ComboBox SelectedItem="{Binding SelectedMode}" Margin="0,0,0,16">
                            <enums:CompressionMode>LosslessFirst</enums:CompressionMode>
                            <enums:CompressionMode>VisuallyOptimized</enums:CompressionMode>
                            <enums:CompressionMode>MaximumSavings</enums:CompressionMode>
                        </ComboBox>

                        <!-- Quality Slider -->
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="Encoding Quality" Style="{StaticResource SubheaderText}" />
                            <TextBlock Text="{Binding Quality, StringFormat={}{0}%}" HorizontalAlignment="Right" FontWeight="SemiBold" />
                        </Grid>
                        <Slider Minimum="10" Maximum="100" Value="{Binding Quality}"
                                TickFrequency="5" IsSnapToTickEnabled="True" Margin="0,0,0,16" />

                        <!-- Target Image Format -->
                        <TextBlock Text="Output Format" Style="{StaticResource SubheaderText}" Margin="0,0,0,6" />
                        <ComboBox SelectedItem="{Binding TargetFormat}" Margin="0,0,0,16">
                            <enums:TargetImageFormat>Original</enums:TargetImageFormat>
                            <enums:TargetImageFormat>WebP</enums:TargetImageFormat>
                            <enums:TargetImageFormat>Jpeg</enums:TargetImageFormat>
                            <enums:TargetImageFormat>Png</enums:TargetImageFormat>
                        </ComboBox>

                        <!-- Resize Mode -->
                        <TextBlock Text="Resize Mode" Style="{StaticResource SubheaderText}" Margin="0,0,0,6" />
                        <ComboBox SelectedItem="{Binding ResizeMode}" Margin="0,0,0,16">
                            <enums:ResizeMode>None</enums:ResizeMode>
                            <enums:ResizeMode>LongestEdge</enums:ResizeMode>
                            <enums:ResizeMode>MaxWidthHeight</enums:ResizeMode>
                            <enums:ResizeMode>Percentage</enums:ResizeMode>
                            <enums:ResizeMode>ExactFit</enums:ResizeMode>
                        </ComboBox>

                        <!-- Resize Parameters -->
                        <StackPanel Visibility="{Binding ResizeMode, Converter={StaticResource EqualsToVisibilityConverter}, ConverterParameter=LongestEdge}" Margin="0,0,0,16">
                            <TextBlock Text="Longest Edge (pixels)" Style="{StaticResource SubheaderText}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding LongestEdge}" />
                        </StackPanel>

                        <StackPanel Visibility="{Binding ResizeMode, Converter={StaticResource EqualsToVisibilityConverter}, ConverterParameter=Percentage}" Margin="0,0,0,16">
                            <TextBlock Text="Scale Percentage (%)" Style="{StaticResource SubheaderText}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding ResizePercentage}" />
                        </StackPanel>

                        <StackPanel Visibility="{Binding ResizeMode, Converter={StaticResource EqualsToVisibilityConverter}, ConverterParameter=MaxWidthHeight}" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Max Width" Style="{StaticResource SubheaderText}" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding MaxWidth}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Max Height" Style="{StaticResource SubheaderText}" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding MaxHeight}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <!-- Metadata Policy -->
                        <TextBlock Text="Metadata Policy" Style="{StaticResource SubheaderText}" Margin="0,0,0,6" />
                        <ComboBox SelectedItem="{Binding MetadataPolicy}" Margin="0,0,0,16">
                            <enums:MetadataPolicy>PreserveAll</enums:MetadataPolicy>
                            <enums:MetadataPolicy>StripNonEssential</enums:MetadataPolicy>
                            <enums:MetadataPolicy>StripAll</enums:MetadataPolicy>
                        </ComboBox>

                        <!-- Toggles -->
                        <CheckBox Content="Preserve Aspect Ratio" IsChecked="{Binding PreserveAspectRatio}" Margin="0,0,0,10" />
                        <CheckBox Content="Auto-orient via EXIF" IsChecked="{Binding AutoOrientExif}" Margin="0,0,0,16" />

                        <!-- Safe rules note -->
                        <Border Background="{StaticResource InputBgBrush}" CornerRadius="6" Padding="10">
                            <TextBlock Text="Original files are protected by default. Compressed results meet the 15% minimum savings threshold before saving."
                                       Style="{StaticResource SubheaderText}" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Column 3: Before & After Live Preview -->
            <Border Grid.Column="2" Style="{StaticResource ModernCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="Before &amp; After Comparison" Style="{StaticResource SectionTitleText}" />
                        <Border Background="{StaticResource OrangeBrush}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Right"
                                Visibility="{Binding PreviewIsLossy, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="LOSSY APPLIED" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold" />
                        </Border>
                    </Grid>

                    <!-- Side-by-side Images Split -->
                    <Grid Grid.Row="1" Visibility="{Binding HasPreview, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Original Preview -->
                        <Border Grid.Column="0" Background="{StaticResource InputBgBrush}" CornerRadius="6" Margin="0,0,6,0">
                            <Grid>
                                <Image Source="{Binding OriginalImagePreview}" Stretch="Uniform" Margin="8" />
                                <Border Background="#80000000" CornerRadius="4" Padding="6,2" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="8">
                                    <TextBlock Text="ORIGINAL" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" />
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Separator -->
                        <Rectangle Grid.Column="1" Fill="{StaticResource BorderBrush}" />

                        <!-- Processed Preview -->
                        <Border Grid.Column="2" Background="{StaticResource InputBgBrush}" CornerRadius="6" Margin="6,0,0,0">
                            <Grid>
                                <Image Source="{Binding ProcessedImagePreview}" Stretch="Uniform" Margin="8" />
                                <Border Background="#8010B981" CornerRadius="4" Padding="6,2" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="8">
                                    <TextBlock Text="OPTIMIZED" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" />
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Empty Preview Placeholder -->
                    <Border Grid.Row="1" Background="{StaticResource InputBgBrush}" CornerRadius="6"
                            Visibility="{Binding HasPreview, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="Select a file and click 'Test Selected' to inspect before &amp; after comparison."
                                       Style="{StaticResource SubheaderText}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Preview Metrics Bar -->
                    <Border Grid.Row="2" Background="{StaticResource SurfaceBgBrush}" CornerRadius="8" Margin="0,12,0,0" Padding="14,10"
                            Visibility="{Binding HasPreview, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Original Size" Style="{StaticResource SubheaderText}" />
                                <TextBlock Text="{Binding PreviewOriginalSize}" FontWeight="SemiBold" />
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Optimized Size" Style="{StaticResource SubheaderText}" />
                                <TextBlock Text="{Binding PreviewProcessedSize}" FontWeight="SemiBold" Foreground="{StaticResource GreenBrush}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Saved Space" Style="{StaticResource SubheaderText}" />
                                <TextBlock Text="{Binding PreviewSavings}" FontWeight="Bold" Foreground="{StaticResource GreenBrush}" />
                            </StackPanel>

                            <StackPanel Grid.Column="3">
                                <TextBlock Text="Dimensions" Style="{StaticResource SubheaderText}" />
                                <TextBlock Text="{Binding PreviewProcessedDimensions}" FontWeight="SemiBold" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2" Style="{StaticResource ModernCard}" Margin="0,16,0,0" Padding="12,8">
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource SubheaderText}" />
        </Border>
    </Grid>
</UserControl>
