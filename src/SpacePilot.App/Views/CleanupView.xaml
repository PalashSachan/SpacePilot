<UserControl x:Class="SpacePilot.App.Views.CleanupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SpacePilot.App.ViewModels"
             mc:Ignorable="d" d:DesignHeight="700" d:DesignWidth="1000">

    <Grid Margin="24">
        <!-- Main Content -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Storage Usage Analyzer &amp; Safe Cleanup" Style="{StaticResource HeaderTitleText}" />
                    <TextBlock Text="Identify large files, recursive folder waste, and duplicate candidate objects across your S3 bucket."
                               Style="{StaticResource SubheaderText}" Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Run Deep Analysis" Style="{StaticResource PrimaryButton}"
                            Command="{Binding RunAnalysisCommand}" />
                </StackPanel>
            </Grid>

            <!-- Metrics Card -->
            <Grid Grid.Row="1" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource ModernCard}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="POTENTIAL RECLAIMABLE WASTE" Style="{StaticResource SubheaderText}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding PotentialWastedStorage}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource OrangeBrush}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource ModernCard}">
                    <StackPanel>
                        <TextBlock Text="TARGET BUCKET" Style="{StaticResource SubheaderText}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ActiveBucket}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource CyanAccentBrush}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Analysis Tabs / Panels -->
            <TabControl Grid.Row="2" Background="Transparent" BorderThickness="0">
                <!-- Tab 1: Largest Files -->
                <TabItem Header="Largest Files">
                    <Border Style="{StaticResource ModernCard}" Margin="0,10,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <TextBlock Text="Top Largest Objects In Bucket" Style="{StaticResource SectionTitleText}" />
                                <Button Content="Delete Selected" Style="{StaticResource DangerButton}" HorizontalAlignment="Right"
                                        Command="{Binding PrepareDeleteCommand}"
                                        CommandParameter="{Binding SelectedItems, ElementName=LargestFilesGrid}" />
                            </Grid>

                            <DataGrid x:Name="LargestFilesGrid" Grid.Row="1" ItemsSource="{Binding LargestFiles}"
                                      AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                      HeadersVisibility="Column" SelectionMode="Extended">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="File Name" Binding="{Binding FileName}" Width="*" />
                                    <DataGridTextColumn Header="Prefix" Binding="{Binding Prefix}" Width="200" />
                                    <DataGridTextColumn Header="Size" Binding="{Binding SizeBytes, Converter={StaticResource ByteSizeConverter}}" Width="110" />
                                    <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="80" />
                                    <DataGridTextColumn Header="Last Modified" Binding="{Binding LastModified, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="140" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </TabItem>

                <!-- Tab 2: Largest Folders -->
                <TabItem Header="Largest Folders">
                    <Border Style="{StaticResource ModernCard}" Margin="0,10,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Top Largest Subtree Prefixes" Style="{StaticResource SectionTitleText}" Margin="0,0,0,10" />

                            <DataGrid Grid.Row="1" ItemsSource="{Binding LargestFolders}"
                                      AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                      HeadersVisibility="Column">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Prefix" Binding="{Binding Prefix}" Width="*" />
                                    <DataGridTextColumn Header="Recursive Size" Binding="{Binding RecursiveSizeBytes, Converter={StaticResource ByteSizeConverter}}" Width="120" />
                                    <DataGridTextColumn Header="Objects" Binding="{Binding RecursiveObjectCount}" Width="80" />
                                    <DataGridTextColumn Header="% of Total Bucket" Binding="{Binding PercentageOfBucket, Converter={StaticResource SavingsPercentageConverter}}" Width="120" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </TabItem>

                <!-- Tab 3: Duplicate Candidates -->
                <TabItem Header="Duplicate Candidates">
                    <Border Style="{StaticResource ModernCard}" Margin="0,10,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Candidate Duplicate Groups (Same Size &amp; ETag/Hash)" Style="{StaticResource SectionTitleText}" Margin="0,0,0,10" />

                            <DataGrid Grid.Row="1" ItemsSource="{Binding Duplicates}"
                                      AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                      HeadersVisibility="Column">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ETag / Hash" Binding="{Binding ETagOrHash}" Width="*" />
                                    <DataGridTextColumn Header="Object Size" Binding="{Binding SizeBytes, Converter={StaticResource ByteSizeConverter}}" Width="110" />
                                    <DataGridTextColumn Header="Copies" Binding="{Binding FileCount}" Width="70" />
                                    <DataGridTextColumn Header="Wasted Volume" Binding="{Binding WastedSizeBytes, Converter={StaticResource ByteSizeConverter}}" Width="120" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </TabItem>
            </TabControl>

            <!-- Status Bar -->
            <Border Grid.Row="3" Style="{StaticResource ModernCard}" Margin="0,16,0,0" Padding="12,8">
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource SubheaderText}" />
            </Border>
        </Grid>

        <!-- Safe Deletion Confirmation Modal Overlay -->
        <Border Background="#C0000000" Visibility="{Binding ShowDeleteDialog, Converter={StaticResource BoolToVisibilityConverter}}"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border Style="{StaticResource ModernCard}" Width="480" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24"
                    BorderBrush="{StaticResource RedBrush}" BorderThickness="1.5">
                <StackPanel>
                    <TextBlock Text="Safeguarded Object Deletion" FontSize="20" FontWeight="Bold" Foreground="{StaticResource RedBrush}" Margin="0,0,0,12" />

                    <TextBlock Text="WARNING: Permanent cloud object deletion may be irreversible. If object versioning is enabled, deleting current versions will retain noncurrent versions in storage."
                               Style="{StaticResource SubheaderText}" TextWrapping="Wrap" Margin="0,0,0,16" />

                    <Border Background="{StaticResource SurfaceBgBrush}" CornerRadius="6" Padding="12" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="{Binding ItemsToDeleteCount, StringFormat=Objects to delete: {0}}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding BytesToDeleteFormatted, StringFormat=Total space affected: {0}}" Foreground="{StaticResource OrangeBrush}" FontWeight="SemiBold" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{Binding ActiveBucket, StringFormat={}{0} (type bucket name to confirm):}" Style="{StaticResource SubheaderText}" Margin="0,0,0,6" />
                    <TextBox Text="{Binding DeleteConfirmationInput, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,20" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Content="Confirm Permanent Delete" Style="{StaticResource DangerButton}"
                                Command="{Binding ConfirmDeleteCommand}" />
                        <Button Grid.Column="2" Content="Cancel" Style="{StaticResource SecondaryButton}"
                                Command="{Binding CancelDeleteCommand}" />
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

    </Grid>
</UserControl>
