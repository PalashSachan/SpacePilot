<UserControl x:Class="SpacePilot.App.Views.ExplorerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SpacePilot.App.ViewModels"
             mc:Ignorable="d" d:DesignHeight="700" d:DesignWidth="1000">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Row 0: Top Command Bar -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Profile Selector -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                <TextBlock Text="Profile:" VerticalAlignment="Center" Margin="0,0,8,0" Style="{StaticResource SubheaderText}" />
                <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}"
                          DisplayMemberPath="Name" Width="220" />
            </StackPanel>

            <!-- Bucket Selector -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                <TextBlock Text="Bucket:" VerticalAlignment="Center" Margin="0,0,8,0" Style="{StaticResource SubheaderText}" />
                <ComboBox ItemsSource="{Binding Buckets}" SelectedItem="{Binding SelectedProfile.BucketName}" Width="160" />
            </StackPanel>

            <!-- Actions -->
            <StackPanel Grid.Column="3" Orientation="Horizontal">
                <Button Content="Scan Bucket" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0"
                        Command="{Binding StartScanCommand}" IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                <Button Content="Cancel Scan" Style="{StaticResource DangerButton}" Margin="0,0,10,0"
                        Command="{Binding CancelScanCommand}" Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibilityConverter}}" />
                <Button Content="Navigate Up" Style="{StaticResource SecondaryButton}"
                        Command="{Binding NavigateUpCommand}" />
            </StackPanel>
        </Grid>

        <!-- Row 1: Scan Progress Banner (when scanning) -->
        <Border Grid.Row="1" Style="{StaticResource ModernCard}" Margin="0,0,0,16" Padding="14,10"
                Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding StatusMessage}" FontWeight="SemiBold" />
                <TextBlock Grid.Row="0" Grid.Column="1" Foreground="{StaticResource CyanAccentBrush}"
                           Text="{Binding ScannedObjects, StringFormat={}{0:N0} objects indexed}" />

                <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" IsIndeterminate="True" Height="6" Margin="0,8,0,0" />
            </Grid>
        </Border>

        <!-- Row 2: Breadcrumbs and Search Bar -->
        <Border Grid.Row="2" Style="{StaticResource ModernCard}" Margin="0,0,0,16" Padding="10,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="220" />
                </Grid.ColumnDefinitions>

                <!-- Clickable Breadcrumbs Trail -->
                <ItemsControl Grid.Column="0" ItemsSource="{Binding Breadcrumbs}" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="{Binding Name}" Style="{StaticResource SubtleButton}"
                                        Command="{Binding DataContext.NavigateToPrefixCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding Prefix}" FontWeight="Medium" />
                                <TextBlock Text="/" Margin="4,0" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Filter ComboBox -->
                <ComboBox Grid.Column="1" SelectedItem="{Binding SelectedFilter}" Width="110" Margin="0,0,10,0">
                    <ComboBoxItem Content="All" IsSelected="True" />
                    <ComboBoxItem Content="Images" />
                    <ComboBoxItem Content="PDFs" />
                </ComboBox>

                <!-- Search Input -->
                <TextBox Grid.Column="2" Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Search files within this folder..." />
            </Grid>
        </Border>

        <!-- Row 3: Dual Grid (Subfolders & Files) -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Subfolders Column -->
            <Border Grid.Column="0" Style="{StaticResource ModernCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Subfolders (Recursive Sizes)" Style="{StaticResource SectionTitleText}" Margin="0,0,0,10" />

                    <DataGrid Grid.Row="1" ItemsSource="{Binding Folders}" SelectedItem="{Binding SelectedFolder}"
                              AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                              HeadersVisibility="Column" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Folder" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="Recursive Size" Binding="{Binding RecursiveSizeBytes, Converter={StaticResource ByteSizeConverter}}" Width="110" />
                            <DataGridTextColumn Header="Files" Binding="{Binding RecursiveObjectCount}" Width="65" />
                            <DataGridTextColumn Header="% Bucket" Binding="{Binding PercentageOfBucket, Converter={StaticResource SavingsPercentageConverter}}" Width="70" />
                        </DataGrid.Columns>
                        <DataGrid.InputBindings>
                            <MouseBinding Gesture="LeftDoubleClick"
                                          Command="{Binding OpenFolderCommand}"
                                          CommandParameter="{Binding SelectedFolder}" />
                        </DataGrid.InputBindings>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent" />

            <!-- Objects / Files Column -->
            <Border Grid.Column="2" Style="{StaticResource ModernCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="Files In Current Folder" Style="{StaticResource SectionTitleText}" />
                        <TextBlock Text="{Binding Files.Count, StringFormat={}{0} files}" HorizontalAlignment="Right" Style="{StaticResource SubheaderText}" />
                    </Grid>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedObject}"
                              AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                              HeadersVisibility="Column">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Download &amp; Open"
                                          Command="{Binding DownloadSelectedCommand}"
                                          CommandParameter="{Binding SelectedObject}" />
                                <MenuItem Header="Copy Key"
                                          Command="{Binding CopyKeyCommand}"
                                          CommandParameter="{Binding SelectedObject}" />
                                <MenuItem Header="Copy S3 URL"
                                          Command="{Binding CopyUrlCommand}"
                                          CommandParameter="{Binding SelectedObject}" />
                                <Separator />
                                <MenuItem Header="Inspect Metadata"
                                          Command="{Binding InspectMetadataCommand}"
                                          CommandParameter="{Binding SelectedObject}" />
                                <Separator />
                                <MenuItem Header="Delete Selected Object"
                                          Command="{Binding DeleteObjectCommand}"
                                          CommandParameter="{Binding SelectedObject}" />
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding FileName}" Width="*" />
                            <DataGridTextColumn Header="Ext" Binding="{Binding Extension}" Width="60" />
                            <DataGridTextColumn Header="Size" Binding="{Binding SizeBytes, Converter={StaticResource ByteSizeConverter}}" Width="100" />
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="80" />
                            <DataGridTextColumn Header="Last Modified" Binding="{Binding LastModified, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="140" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- Row 4: Status Bar / Metadata Drawer -->
        <Border Grid.Row="4" Style="{StaticResource ModernCard}" Margin="0,16,0,0" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" Style="{StaticResource SubheaderText}" VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CurrentPrefix, StringFormat=Prefix: /{0}}" Style="{StaticResource SubheaderText}" />
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</UserControl>
