<UserControl x:Class="SpacePilot.App.Views.JobsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SpacePilot.App.ViewModels"
             mc:Ignorable="d" d:DesignHeight="700" d:DesignWidth="1000">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Header & Action Buttons -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Jobs, Tasks &amp; Activity Audit" Style="{StaticResource HeaderTitleText}" />
                <TextBlock Text="Persistent execution engine with pause/resume, retry capabilities, and structured diagnostic logging"
                           Style="{StaticResource SubheaderText}" Margin="0,4,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Pause" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                        Command="{Binding PauseJobCommand}" CommandParameter="{Binding SelectedJob}" />
                <Button Content="Resume" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                        Command="{Binding ResumeJobCommand}" CommandParameter="{Binding SelectedJob}" />
                <Button Content="Cancel" Style="{StaticResource DangerButton}" Margin="0,0,8,0"
                        Command="{Binding CancelJobCommand}" CommandParameter="{Binding SelectedJob}" />
                <Button Content="Retry Failed" Style="{StaticResource SecondaryButton}" Margin="0,0,16,0"
                        Command="{Binding RetryFailedCommand}" CommandParameter="{Binding SelectedJob}" />

                <Button Content="Open Logs" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                        Command="{Binding OpenLogsFolderCommand}" />
                <Button Content="Export Diagnostic Report" Style="{StaticResource PrimaryButton}"
                        Command="{Binding ExportDiagnosticReportCommand}" />
            </StackPanel>
        </Grid>

        <!-- Main Split: Jobs List on Left, Tabs on Right -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: Jobs List -->
            <Border Grid.Column="0" Style="{StaticResource ModernCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="Compression Jobs" Style="{StaticResource SectionTitleText}" />
                        <Button Content="Refresh" Style="{StaticResource SubtleButton}" HorizontalAlignment="Right"
                                Command="{Binding RefreshJobsCommand}" />
                    </Grid>

                    <ListBox Grid.Row="1" ItemsSource="{Binding Jobs}" SelectedItem="{Binding SelectedJob}"
                             Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ModernCard}" Margin="0,0,0,8" Padding="12,10">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,6">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Width="200" HorizontalAlignment="Left" />
                                            <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Right"
                                                    Background="{Binding Status, Converter={StaticResource StatusToColorConverter}}">
                                                <TextBlock Text="{Binding Status}" Foreground="#FFFFFF" FontSize="10" FontWeight="Bold" />
                                            </Border>
                                        </Grid>

                                        <TextBlock Text="{Binding StartedAt, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" Style="{StaticResource SubheaderText}" />

                                        <Grid Margin="0,6,0,0">
                                            <TextBlock Text="{Binding ProcessedFiles, StringFormat={}{0} files processed}" Style="{StaticResource SubheaderText}" />
                                            <TextBlock Text="{Binding SavedBytes, Converter={StaticResource ByteSizeConverter}, StringFormat=Saved: {0}}"
                                                       HorizontalAlignment="Right" Foreground="{StaticResource GreenBrush}" FontWeight="SemiBold" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="8" Background="Transparent" />

            <!-- Right: Tabbed Details (Items, Audit Log, Live Logs) -->
            <TabControl Grid.Column="2" Background="Transparent" BorderThickness="0">
                <!-- Tab 1: Selected Job Items -->
                <TabItem Header="Job Items">
                    <Border Style="{StaticResource ModernCard}" Margin="0,10,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <TextBlock Text="Items in Selected Job" Style="{StaticResource SectionTitleText}" />
                                <TextBlock Text="{Binding JobItems.Count, StringFormat={}{0} items}" HorizontalAlignment="Right" Style="{StaticResource SubheaderText}" />
                            </Grid>

                            <DataGrid Grid.Row="1" ItemsSource="{Binding JobItems}"
                                      AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                      HeadersVisibility="Column">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Source" Binding="{Binding SourceKeyOrPath}" Width="*" />
                                    <DataGridTextColumn Header="Original" Binding="{Binding OriginalSizeBytes, Converter={StaticResource ByteSizeConverter}}" Width="90" />
                                    <DataGridTextColumn Header="Processed" Binding="{Binding ProcessedSizeBytes, Converter={StaticResource ByteSizeConverter}}" Width="90" />
                                    <DataGridTextColumn Header="Savings %" Binding="{Binding SavedPercentage, Converter={StaticResource SavingsPercentageConverter}}" Width="80" />
                                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110" />
                                    <DataGridTextColumn Header="Details" Binding="{Binding ErrorDetails}" Width="150" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </TabItem>

                <!-- Tab 2: Activity Audit Log -->
                <TabItem Header="Activity Audit Log">
                    <Border Style="{StaticResource ModernCard}" Margin="0,10,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <TextBlock Text="Persistent Activity Log" Style="{StaticResource SectionTitleText}" />
                                <TextBox Text="{Binding FilterSearch, UpdateSourceTrigger=PropertyChanged}" Width="200" HorizontalAlignment="Right" />
                            </Grid>

                            <DataGrid Grid.Row="1" ItemsSource="{Binding ActivityLogs}"
                                      AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                      HeadersVisibility="Column">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Timestamp" Binding="{Binding Timestamp, StringFormat={}{0:HH:mm:ss}}" Width="90" />
                                    <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="110" />
                                    <DataGridTextColumn Header="Item" Binding="{Binding ObjectKeyOrFileName}" Width="*" />
                                    <DataGridTextColumn Header="Orig Size" Binding="{Binding OriginalSizeBytes, Converter={StaticResource ByteSizeConverter}}" Width="90" />
                                    <DataGridTextColumn Header="New Size" Binding="{Binding ProcessedSizeBytes, Converter={StaticResource ByteSizeConverter}}" Width="90" />
                                    <DataGridTextColumn Header="Saved %" Binding="{Binding SavedPercentage, Converter={StaticResource SavingsPercentageConverter}}" Width="80" />
                                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </TabItem>

                <!-- Tab 3: Live Application Logs -->
                <TabItem Header="Diagnostics &amp; System Logs">
                    <Border Style="{StaticResource ModernCard}" Margin="0,10,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <TextBlock Text="Real-Time Structured Diagnostic Stream" Style="{StaticResource SectionTitleText}" />
                                <Button Content="Clear Old Archives" Style="{StaticResource SubtleButton}" HorizontalAlignment="Right"
                                        Command="{Binding ClearOldLogsCommand}" />
                            </Grid>

                            <ListBox Grid.Row="1" ItemsSource="{Binding LogLines}" Background="{StaticResource InputBgBrush}"
                                     BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontFamily="Consolas, Segoe UI" FontSize="11" Margin="2,1" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</UserControl>
