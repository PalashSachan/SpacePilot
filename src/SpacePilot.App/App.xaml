<Application x:Class="SpacePilot.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SpacePilot.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Colors.xaml" />
                <ResourceDictionary Source="Themes/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Global Converters -->
            <converters:ByteSizeConverter x:Key="ByteSizeConverter" xmlns:converters="clr-namespace:SpacePilot.App.Converters" />
            <converters:SavingsPercentageConverter x:Key="SavingsPercentageConverter" xmlns:converters="clr-namespace:SpacePilot.App.Converters" />
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" xmlns:converters="clr-namespace:SpacePilot.App.Converters" />
            <converters:BoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" Invert="True" xmlns:converters="clr-namespace:SpacePilot.App.Converters" />
            <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" xmlns:converters="clr-namespace:SpacePilot.App.Converters" />
            <converters:StatusToColorConverter x:Key="StatusToColorConverter" xmlns:converters="clr-namespace:SpacePilot.App.Converters" />
            <converters:EqualsToVisibilityConverter x:Key="EqualsToVisibilityConverter" xmlns:converters="clr-namespace:SpacePilot.App.Converters" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
